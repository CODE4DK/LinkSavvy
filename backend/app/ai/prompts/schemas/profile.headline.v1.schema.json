{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "variants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "text": { "type": "string", "minLength": 1 },
          "rationale": { "type": "string", "minLength": 1 },
          "keywords": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "required": ["text", "rationale", "keywords"],
        "additionalProperties": false
      }
    }
  },
  "required": ["variants"],
  "additionalProperties": false
}
