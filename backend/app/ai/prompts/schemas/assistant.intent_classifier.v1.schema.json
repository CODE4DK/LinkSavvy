{
  "type": "object",
  "properties": {
    "intent": {
      "type": "string",
      "enum": [
        "run_tool",
        "explain",
        "coach",
        "analyse_my_data",
        "smalltalk",
        "out_of_scope",
        "policy_violation"
      ]
    },
    "tool_candidates": {
      "type": "array",
      "items": { "type": "string" }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "needs_context": {
      "type": "array",
      "items": { "type": "string", "enum": ["workspace", "audit"] }
    },
    "policy_category": {
      "type": ["string", "null"],
      "enum": [
        "automation",
        "scraping",
        "engagement_manipulation",
        "impersonation",
        "fabrication",
        "bulk_undisclosed_messaging",
        null
      ]
    }
  },
  "required": ["intent", "tool_candidates", "confidence", "needs_context", "policy_category"],
  "additionalProperties": false
}
