ENV=development

# mysql+aiomysql://user:password@host:3306/dbname
DATABASE_URL=mysql+aiomysql://linksavvy:linksavvy@localhost:3306/linksavvy

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
REFRESH_TOKEN_PEPPER=change-me

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=change-me

FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=["http://localhost:5173"]

SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=LinkSavvy <no-reply@linksavvy.app>

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:5173/auth/linkedin/callback
# A second redirect URI registered on the same LinkedIn app, used only by
# the profile-connect flow (Phase 02) so it's never confused with sign-in.
LINKEDIN_PROFILE_REDIRECT_URI=http://localhost:5173/profile/connect/callback

# AI Gateway (Phase 03). Which model each key actually pays for is decided
# by config/models.yaml, never here.
OPENAI_API_KEY=
GEMINI_API_KEY=
