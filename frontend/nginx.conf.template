# Uses the official nginx image's built-in envsubst-on-startup templating
# (any file under /etc/nginx/templates/*.template is rendered to
# /etc/nginx/conf.d/ with ${VAR} substituted, no custom entrypoint
# needed) -- API_UPSTREAM is set per environment (staging/production),
# see docs/runbook.md "Deploying".
server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # Route-chunk JS/CSS are content-hashed (see docs/performance.md
    # "Frontend code splitting") -- safe to cache forever.
    location ~* \.(?:js|css|woff2?)$ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    location /api/ {
        proxy_pass ${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # SPA fallback: any other path serves index.html so client-side
    # routing (react-router-dom) handles it, and index.html itself is
    # never cached so a redeploy is picked up on next load.
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri /index.html;
    }
}
